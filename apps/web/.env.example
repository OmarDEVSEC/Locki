# Optional: enables real ToS/Privacy Policy red-flag analysis via Claude.
# Without it, ToS status falls back to "unavailable" rather than being faked.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# SQLite file path for local/demo use. Swap for a Postgres/RDS connection
# string + a different lib/db.ts driver when moving to AWS.
DB_PATH=./data/locki.db
